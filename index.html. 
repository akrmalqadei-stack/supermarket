  start() {
    this.stop();
    const mins = state.settings.autoLockMinutes || 15;
    this.timer = setTimeout(() => this.lock(), mins * 60 * 1000);
  },
  stop() { if (this.timer) { clearTimeout(this.timer); this.timer = null; } },
  lock() {
    if (!Auth.user) return;
    $("lockScreen").classList.add("show");
    $("lockPass").value = "";
    $("lockErr").textContent = "";
    setTimeout(() => $("lockPass")?.focus(), 100);
  },
