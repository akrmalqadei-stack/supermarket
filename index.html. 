    box.innerHTML = '<div class="empty" style="padding:24px 12px;border:none;background:transparent"><span class="ic" style="font-size:36px">🛒</span><strong style="font-size:13px">الفاتورة فارغة</strong><span>اضغط على منتج</span></div>';
  } else {
    box.innerHTML = state.cart.map(line => {
      const p = state.products.find(x => x.id === line.productId); if (!p) return "";
      return '<div class="ci"><div class="ii"><strong>' + esc(p.name) + '</strong><span>' + money(p.sellPrice) + '</span></div><div class="cq"><button onclick="POS.changeQty(\'' + p.id + '\',1)">+</button><span>' + line.qty + '</span><button onclick="POS.changeQty(\'' + p.id + '\',-1)">−</button></div><div class="cit">' + money(p.sellPrice * line.qty) + '</div></div>';
    }).join("");
  }
  const sub = POS.subtotal(), disc = POS.discountAmount(), total = Math.max(sub - disc, 0);
  if ($("cartTotal")) $("cartTotal").textContent = money(total);
  if ($("subTotal")) $("subTotal").textContent = money(sub);
  if ($("discountDisplay")) $("discountDisplay").textContent = disc > 0 ? "-" + money(disc) : money(0);
