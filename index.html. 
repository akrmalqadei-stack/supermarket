const Settings = {
  async saveStore() {
    state.settings.storeName = $("setStoreName").value.trim() || "متجر";
    state.settings.currency = $("setCurrency").value.trim() || "ر.ي";
    state.settings.autoLockMinutes = Number($("setAutoLock").value) || 15;
    await sendChange("settings.update", { storeName: state.settings.storeName, currency: state.settings.currency, autoLockMinutes: state.settings.autoLockMinutes });
    Auth.renderHeader();
    Lock.start();
    toast("تم الحفظ", "success");
  },
  async changePassword() {
    const c = $("curPass").value, n = $("newPass").value, cf = $("confirmPass").value;
    const hashCur = await hashPassword(c, Auth.user.salt);
    if (hashCur !== Auth.user.passwordHash) { toast("كلمة المرور الحالية خاطئة", "error"); return; }
    if (n.length < 4) { toast("كلمة المرور قصيرة", "error"); return; }
    if (n !== cf) { toast("غير متطابقتين", "error"); return; }
    const newSalt = genSalt();
    const newHash = await hashPassword(n, newSalt);
    Auth.user.salt = newSalt;
    Auth.user.passwordHash = newHash;
    await sendChange("user.upsert", Auth.user);
    ["curPass", "newPass", "confirmPass"].forEach(id => $(id).value = "");
    toast("تم التحديث", "success");
  }
};

/* ===== Backup ===== */
const Backup = {
  async export() {
    const data = { app: "SuperMarketPro", version: 5, exportedAt: new Date().toISOString(), users: state.users, branches: state.branches, products: state.products, sales: state.sales, customers: state.customers, registers: state.registers, settings: state.settings };
    const blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a"); a.href = url; a.download = "backup-" + dayKey(new Date()) + ".json"; a.click();
    URL.revokeObjectURL(url);
    toast("تم التصدير", "success");
  },
  import() {
    const input = document.createElement("input"); input.type = "file"; input.accept = ".json";
    input.onchange = async e => {
      const file = e.target.files[0];
      const reader = new FileReader();
      reader.onload = async ev => {
        try {
          const data = JSON.parse(ev.target.result);
          if (!data.users || !data.products) { toast("ملف غير صالح", "error"); return; }
          // save everything
          for (const u of data.users || []) await dbPut("users", u);
          for (const b of data.branches || []) await dbPut("branches", b);
          for (const p of data.products || []) await dbPut("products", p);
          for (const s of data.sales || []) await dbPut("sales", s);
          for (const c of data.customers || []) await dbPut("customers", c);
          for (const r of data.registers || []) await dbPut("registers", r);
          if (data.settings) { Object.assign(state.settings, data.settings); await saveSettings(); }
          await loadState();
          toast("تم الاستيراد", "success");
          Auth.renderHeader();
          renderSection(state.currentSection);
        } catch (err) { toast("خطأ في الملف", "error"); }
      };
      reader.readAsText(file);
    };
    input.click();
  },
  async clearAll() {
    if (!await askConfirm("سيتم حذف كل البيانات نهائياً!", "حذف الكل", "حذف")) return;
    return new Promise((res) => {
      const req = indexedDB.deleteDatabase(DB_NAME);
      req.onsuccess = () => { sessionStorage.clear(); location.reload(); };
      req.onerror = () => { toast("خطأ", "error"); res(); };
    });
  }
};

