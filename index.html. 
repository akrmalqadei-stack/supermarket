const Print = {
  print() { window.print(); },
  pdf() {
    if (!window._lastSale) return;
    if (typeof window.jspdf === "undefined") { toast("مكتبة PDF لم تُحمّل", "error"); return; }
    const { jsPDF } = window.jspdf;
    const s = window._lastSale;
    const doc = new jsPDF({ unit: "mm", format: [80, 200] });
    doc.setFont("helvetica");
    doc.setFontSize(12);
    let y = 10;
    doc.text("SuperMarket Pro", 40, y, { align: "center" }); y += 6;
    doc.setFontSize(8);
    doc.text("Invoice #" + s.invoice, 40, y, { align: "center" }); y += 4;
    doc.text(fmtDate(s.date), 40, y, { align: "center" }); y += 6;
    doc.line(5, y, 75, y); y += 4;
    s.items.forEach(i => {
      doc.text(i.name.substring(0, 22), 5, y);
      doc.text(i.qty + " x " + fmt(i.price), 75, y, { align: "right" });
      y += 4;
    });
    doc.line(5, y, 75, y); y += 4;
    doc.setFontSize(10);
    doc.text("Total: " + fmt(s.total) + " YER", 75, y, { align: "right" });
    doc.save("invoice-" + s.invoice + ".pdf");
    toast("تم إنشاء PDF", "success");
  }
};

