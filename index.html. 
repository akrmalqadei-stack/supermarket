/* ===== sendChange ===== */
async function sendChange(type, payload) {
  try {
    if (type === "product.upsert") { await dbPut("products", payload); const i = state.products.findIndex(x => x.id === payload.id); if (i >= 0) state.products[i] = payload; else state.products.push(payload); }
    else if (type === "product.delete") { await dbDelete("products", payload.id); state.products = state.products.filter(x => x.id !== payload.id); }
    else if (type === "sale.upsert") { await dbPut("sales", payload); const i = state.sales.findIndex(x => x.id === payload.id); if (i >= 0) state.sales[i] = payload; else state.sales.push(payload); }
    else if (type === "sale.delete") { await dbDelete("sales", payload.id); state.sales = state.sales.filter(x => x.id !== payload.id); }
    else if (type === "user.upsert") { await dbPut("users", payload); const i = state.users.findIndex(x => x.id === payload.id); if (i >= 0) state.users[i] = payload; else state.users.push(payload); }
    else if (type === "user.delete") { await dbDelete("users", payload.id); state.users = state.users.filter(x => x.id !== payload.id); }
    else if (type === "branch.upsert") { await dbPut("branches", payload); const i = state.branches.findIndex(x => x.id === payload.id); if (i >= 0) state.branches[i] = payload; else state.branches.push(payload); }
    else if (type === "branch.delete") {
      await dbDelete("branches", payload.id);
      state.branches = state.branches.filter(x => x.id !== payload.id);
      const toDel = state.products.filter(x => x.branchId === payload.id);
      for (const p of toDel) await dbDelete("products", p.id);
      state.products = state.products.filter(x => x.branchId !== payload.id);
    }
    else if (type === "customer.upsert") { await dbPut("customers", payload); const i = state.customers.findIndex(x => x.id === payload.id); if (i >= 0) state.customers[i] = payload; else state.customers.push(payload); }
    else if (type === "customer.delete") { await dbDelete("customers", payload.id); state.customers = state.customers.filter(x => x.id !== payload.id); }
    else if (type === "register.upsert") { await dbPut("registers", payload); const i = state.registers.findIndex(x => x.id === payload.id); if (i >= 0) state.registers[i] = payload; else state.registers.push(payload); }
    else if (type === "settings.update") { Object.assign(state.settings, payload); await saveSettings(); }
    return true;
  } catch (e) { console.error(e); return false; }
}

