function renderReportsCharts() {
  if (typeof Chart === "undefined") return;
  const S = Data.sales();
  Chart.defaults.font.family = "Cairo";
  Chart.defaults.color = getComputedStyle(document.body).color;

  // Week chart
  const days = [];
  for (let i = 6; i >= 0; i--) { const d = new Date(); d.setDate(d.getDate() - i); days.push({ k: dayKey(d), l: d.toLocaleDateString("ar-EG", { weekday: "short" }), t: 0 }); }
  S.forEach(s => { const d = days.find(x => x.k === dayKey(s.date)); if (d) d.t += s.total; });
  const ctx1 = $("weekChart");
  if (ctx1) new Chart(ctx1, { type: "bar", data: { labels: days.map(d => d.l), datasets: [{ label: "المبيعات", data: days.map(d => d.t), backgroundColor: "#6366f1", borderRadius: 8 }] }, options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } } });

  // Cashier chart
  const by = {};
  S.forEach(s => { const n = s.cashierName || "غير معروف"; by[n] = (by[n] || 0) + s.total; });
  const ctx2 = $("cashierChart");
  if (ctx2) new Chart(ctx2, { type: "doughnut", data: { labels: Object.keys(by), datasets: [{ data: Object.values(by), backgroundColor: ["#6366f1", "#ec4899", "#10b981", "#f59e0b", "#06b6d4", "#8b5cf6"] }] }, options: { responsive: true, maintainAspectRatio: false } });

  // Category chart
  const catMap = {};
  S.forEach(s => s.items.forEach(i => { const p = state.products.find(x => x.id === i.id); const cat = (p && p.category) ? p.category : "غير مصنف"; catMap[cat] = (catMap[cat] || 0) + i.total; }));
  const ctx3 = $("catChart");
  if (ctx3) new Chart(ctx3, { type: "polarArea", data: { labels: Object.keys(catMap), datasets: [{ data: Object.values(catMap), backgroundColor: ["#6366f1cc", "#ec4899cc", "#10b981cc", "#f59e0bcc", "#06b6d4cc", "#8b5cf6cc"] }] }, options: { responsive: true, maintainAspectRatio: false } });

  // Top products
  $("topProductsReport").innerHTML = renderTopProducts(S, 8);
}

