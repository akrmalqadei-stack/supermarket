function cashierGoalCard() {
  const user = Auth.user;
  const target = user.target || 50000;
  const todaySales = Data.sales().filter(s => isToday(s.date) && s.cashierId === user.id).reduce((t, s) => t + s.total, 0);
  const pct = Math.min(Math.round((todaySales / target) * 100), 100);
  return '<div class="goal-c"><div class="gl">🎯 هدف اليوم</div><div class="gv">' + money(todaySales) + ' <small>/ ' + money(target) + '</small></div><div class="gp"><div class="gp-f" style="width:' + pct + '%"></div></div><div class="gp-text"><span>📊 ' + pct + '%</span><span>' + (pct >= 100 ? "🎉 مبروك!" : "⏳ متبقي: " + money(target - todaySales)) + '</span></div></div>';
}

function renderTopProducts(salesArr, limit) {
  const map = new Map();
  salesArr.forEach(s => s.items.forEach(i => { const c = map.get(i.name) || { name: i.name, qty: 0 }; c.qty += i.qty; map.set(i.name, c); }));
  const top = [...map.values()].sort((a, b) => b.qty - a.qty).slice(0, limit);
  if (!top.length) return '<div class="empty"><span class="ic">📊</span><strong>لا توجد مبيعات</strong></div>';
  return top.map((d, i) => '<div class="rank-item"><div class="rnm"><div class="rn">' + (i + 1) + '</div>' + esc(d.name) + '</div><div class="rv">' + fmt(d.qty) + ' قطعة</div></div>').join("");
}

