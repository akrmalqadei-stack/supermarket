  const P = Data.products();
  const low = P.filter(p => p.quantity <= p.minStock);
  if (low.length) state.notifications.push({ icon: "⚠️", title: "مخزون منخفض", text: low.length + " منتج يحتاج إعادة طلب" });
  const out = P.filter(p => p.quantity <= 0);
  if (out.length) state.notifications.push({ icon: "❌", title: "منتجات نفدت", text: out.length + " منتج نفد" });
  const todayS = Data.sales().filter(s => isToday(s.date));
  if (todayS.length) state.notifications.push({ icon: "💰", title: "مبيعات اليوم", text: todayS.length + " فاتورة بإجمالي " + money(todayS.reduce((t, s) => t + s.total, 0)) });
  const badge = $("notifBadge");
  if (state.notifications.length) { badge.textContent = state.notifications.length; badge.classList.remove("hidden"); }
  else badge.classList.add("hidden");
  const list = $("notifList");
  if (list) list.innerHTML = state.notifications.length ? state.notifications.map(n => '<div class="ni-item"><div class="nic">' + n.icon + '</div><div class="nb"><div class="nt">' + n.title + '</div><div class="nx">' + n.text + '</div></div></div>').join("") : '<div style="padding:30px;text-align:center;color:var(--muted);font-weight:700">🔔 لا توجد إشعارات</div>';
}

/* ===== UI ===== */
const UI = {
  toggleSidebar() { $("sidebar").classList.toggle("open"); $("sidebarOverlay").classList.toggle("active"); },
  toggleTheme() {
    const cur = document.documentElement.getAttribute("data-theme");
    const next = cur === "dark" ? "light" : "dark";
    document.documentElement.setAttribute("data-theme", next);
    localStorage.setItem("smpro_theme", next);
    $("themeBtn").textContent = next === "dark" ? "☀️" : "🌙";
    if (state.currentSection === "reports") renderReportsCharts();
  },
  loadTheme() {
    const t = localStorage.getItem("smpro_theme") || "light";
    document.documentElement.setAttribute("data-theme", t);
    const b = $("themeBtn"); if (b) b.textContent = t === "dark" ? "☀️" : "🌙";
  },
  toggleNotif() { $("notifPanel").classList.toggle("active"); generateNotifications(); },
  openModal(id) { $(id).classList.add("active"); },
  closeModal(id) { $(id).classList.remove("active"); }
};

/* ===== PWA ===== */
const PWA = {
  deferredPrompt: null,
  init() {
    window.addEventListener("beforeinstallprompt", (e) => {
      e.preventDefault();
      this.deferredPrompt = e;
      setTimeout(() => $("installPrompt").classList.add("show"), 3000);
    });
    window.addEventListener("appinstalled", () => { $("installPrompt").classList.remove("show"); toast("تم تثبيت التطبيق 🎉", "success"); });
    if ("serviceWorker" in navigator && location.protocol !== "file:") {
      navigator.serviceWorker.register("sw.js").catch(() => {});
    }
    // online/offline
    const updateOnline = () => { $("offlineBadge").classList.toggle("show", !navigator.onLine); };
    window.addEventListener("online", updateOnline);
    window.addEventListener("offline", updateOnline);
    updateOnline();
  },
  async install() {
    if (!this.deferredPrompt) { toast("التثبيت غير متاح", "warning"); return; }
    this.deferredPrompt.prompt();
    const { outcome } = await this.deferredPrompt.userChoice;
    if (outcome === "accepted") toast("تم التثبيت", "success");
    this.deferredPrompt = null;
    $("installPrompt").classList.remove("show");
  },
  dismiss() { $("installPrompt").classList.remove("show"); }
};

/* ===== Keyboard ===== */
document.addEventListener("keydown", e => {
  if (e.key === "Enter" && $("loginPage").style.display !== "none") { Auth.login(); return; }
  if (e.key === "Escape") document.querySelectorAll(".overlay").forEach(o => o.classList.remove("active"));
});
window.addEventListener("resize", () => {
  if (window.innerWidth > 1024) { $("sidebar").classList.remove("open"); $("sidebarOverlay").classList.remove("active"); }
});

// Activity resets lock timer
["click", "keydown", "touchstart", "mousemove"].forEach(evt => {
  document.addEventListener(evt, () => { if (Auth.user && !$("lockScreen").classList.contains("show")) Lock.start(); }, { passive: true });
});

/* ===== Boot ===== */
UI.loadTheme();
PWA.init();

(async function boot() {
  await fetchAll();
  const ok = Auth.checkSession();
  if (!ok) {
    $("loginPage").style.display = "flex";
    $("app").classList.remove("active");
  }
  setInterval(() => {
    const el = $("syncLabel");
    if (el) el.textContent = "محلي · " + new Date().toLocaleTimeString("ar-EG", { hour: "2-digit", minute: "2-digit" });
  }, 30000);
})();
</script>
</body>
