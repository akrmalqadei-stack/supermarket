}

const POS = {
  setCategory(cat) { state.currentCategory = cat; renderPosGrid(); },
  add(pid) {
    const p = Data.products().find(x => x.id === pid);
    if (!p) { toast("المنتج غير موجود", "error"); return; }
    if (p.quantity <= 0) { toast("المنتج غير متوفر", "warning"); return; }
    const line = state.cart.find(c => c.productId === pid);
    const cur = line ? line.qty : 0;
    if (cur + 1 > p.quantity) { toast("الكمية المتوفرة: " + fmt(p.quantity), "warning"); return; }
    if (line) line.qty++; else state.cart.push({ productId: pid, qty: 1 });
    renderCart();
  },
  changeQty(pid, d) {
    const line = state.cart.find(c => c.productId === pid); if (!line) return;
    const p = state.products.find(x => x.id === pid); if (!p) return;
    const nq = line.qty + d;
    if (nq <= 0) state.cart = state.cart.filter(c => c.productId !== pid);
    else if (nq > p.quantity) { toast("الكمية غير كافية", "error"); return; }
    else line.qty = nq;
    renderCart();
  },
  subtotal() { return state.cart.reduce((s, l) => { const p = state.products.find(x => x.id === l.productId); return p ? s + p.sellPrice * l.qty : s; }, 0); },
  discountAmount() { const sub = this.subtotal(); if (state.discount.type === "percent") return Math.round(sub * state.discount.value / 100); return Math.min(state.discount.value, sub); },
  applyDiscount() {
    const t = $("discountType").value, v = Number($("discountValue").value) || 0;
    if (v < 0) { toast("قيمة غير صحيحة", "error"); return; }
    state.discount = { type: t, value: v };
    UI.closeModal("discountModal");
    renderCart();
    toast("تم تطبيق الخصم", "success");
  },
  setPayment(pm) {
    state.currentPayment = pm;
    document.querySelectorAll(".pm").forEach(b => b.classList.toggle("active", b.dataset.pm === pm));
  },
  clear() { if (!state.cart.length) return; state.cart = []; state.discount = { type: "percent", value: 0 }; renderCart(); toast("تم التفريغ", "info"); },
  async checkout() {
    if (!state.cart.length) { toast("الفاتورة فارغة", "error"); return; }
    for (const line of state.cart) { const p = state.products.find(x => x.id === line.productId); if (!p || p.quantity < line.qty) { toast("الكمية غير كافية", "error"); return; } }
    const branchId = Auth.user.branchId || state.branches[0]?.id;
    if (!branchId) { toast("لا يوجد فرع", "error"); return; }
    const items = []; let total = 0, cost = 0;
    for (const line of state.cart) {
      const p = state.products.find(x => x.id === line.productId);
      const lt = p.sellPrice * line.qty;
      total += lt; cost += p.buyPrice * line.qty;
      items.push({ id: p.id, name: p.name, price: p.sellPrice, qty: line.qty, total: lt });
    }
    const disc = this.discountAmount();
    const finalTotal = Math.max(total - disc, 0);
    state.settings.counter = (state.settings.counter || 1000) + 1;
    const sale = { id: uid(), invoice: state.settings.counter, branchId, cashierId: Auth.user.id, cashierName: Auth.user.fullName, items, total: finalTotal, subtotal: total, discount: disc, cost, profit: finalTotal - cost, paymentMethod: state.currentPayment, date: new Date().toISOString() };
    await sendChange("sale.upsert", sale);
    for (const line of state.cart) { const p = state.products.find(x => x.id === line.productId); if (p) { p.quantity -= line.qty; await sendChange("product.upsert", p); } }
    state.cart = []; state.discount = { type: "percent", value: 0 }; state.currentPayment = "cash";
    renderSection("pos");
    showReceipt(sale);
    toast("تم إتمام البيع 🎉", "success");
  }
};

