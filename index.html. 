const Register = {
  async open() {
    const opening = Number($("regOpen").value) || 0;
    if (opening < 0) { toast("قيمة غير صحيحة", "error"); return; }
    const branchId = Auth.user.branchId || state.branches[0]?.id;
    await sendChange("register.upsert", { id: uid(), branchId, date: new Date().toISOString().slice(0, 10), opened: new Date().toISOString(), openedBy: Auth.user.id, opening, closed: null, closing: 0, difference: 0 });
    renderSection("register");
    toast("تم فتح الصندوق 🔓", "success");
  },
  async close() {
    const today = new Date().toISOString().slice(0, 10);
    const branchId = Auth.user.branchId || state.branches[0]?.id;
    const reg = state.registers.find(r => r.date === today && r.branchId === branchId && r.opened); if (!reg) return;
    const cashSales = Data.sales().filter(s => isToday(s.date) && (s.paymentMethod === "cash" || !s.paymentMethod)).reduce((t, s) => t + s.total, 0);
    const expected = reg.opening + cashSales;
    const actual = Number($("regClose").value) || 0;
    reg.closed = new Date().toISOString(); reg.closing = actual; reg.difference = actual - expected; reg.opened = false;
    await sendChange("register.upsert", reg);
    renderSection("register");
    toast(reg.difference === 0 ? "✓ الفرق: 0" : "الفرق: " + money(reg.difference), reg.difference === 0 ? "success" : "warning");
  }
};

